<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" prefHeight="550.0" prefWidth="1000.0" spacing="20" style="-fx-background-color: Green;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lab.MenuController">

   <Label alignment="CENTER" prefHeight="100.0" prefWidth="302.0" text="Frog Man" textFill="#00fc11">
      <font>
         <Font name="Bernard MT Condensed" size="72.0" />
      </font>
   </Label>

   <TextField fx:id="nameField" alignment="CENTER" focusTraversable="false " promptText="Player name:" style="-fx-control-inner-background: green;                      -fx-prompt-text-fill: black; -fx-font-size: 36;                      -fx-border-color: Green;                      -fx-focus-color: transparent;                      -fx-font-family: 'Bernard MT Condensed';                      -fx-max-width: 400;">

   </TextField>
   <Text fx:id="highestScore" strokeType="OUTSIDE" strokeWidth="0.0" text="Highest score: ">
      <font>
         <Font name="Bernard MT Condensed" size="28.0" />
      </font>
   </Text>

   <Button fx:id="play" mnemonicParsing="false" onAction="#playGame" prefHeight="75.0" prefWidth="168.0" text="PLAY" textFill="#222222">
      <font>
         <Font name="Bernard MT Condensed" size="36.0" />
      </font>
      <VBox.margin>
         <Insets top="10.0" />
      </VBox.margin>
   </Button>

   <Button fx:id="showResults" mnemonicParsing="false" onAction="#showResults" prefHeight="75.0" prefWidth="200.0" text="SHOW RESULTS">
      <font>
         <Font name="Bernard MT Condensed" size="28.0" />
      </font>
   </Button>

   <Button fx:id="exit" mnemonicParsing="false" onAction="#exitGame" prefHeight="79.0" prefWidth="162.0" text="EXIT">
      <font>
         <Font name="Bernard MT Condensed" size="36.0" />
      </font>
   </Button>
</VBox>
