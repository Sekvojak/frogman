<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="550.0" prefWidth="1000.0" style="-fx-background-color: Green;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lab.GameOverController">
   <children>
      <Label text="GAME OVER" textAlignment="CENTER">
         <font>
            <Font name="Sitka Text" size="68.0" />
         </font>
         <VBox.margin>
            <Insets bottom="50.0" />
         </VBox.margin>
      </Label>
      <Label fx:id="scoreField" text="Your Score: 0">
         <font>
            <Font name="Sitka Text Italic" size="36.0" />
         </font>
         <VBox.margin>
            <Insets bottom="50.0" />
         </VBox.margin>
      </Label>
      <Button fx:id="exit" mnemonicParsing="false" onAction="#exitGame" prefHeight="84.0" prefWidth="208.0" text="EXIT">
         <font>
            <Font name="Bernard MT Condensed" size="36.0" />
         </font>
         <VBox.margin>
            <Insets bottom="30.0" top="30.0" />
         </VBox.margin>
      </Button>
   </children>
</VBox>
