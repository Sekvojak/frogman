<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %c{1} - %msg%n"/>
        </Console>

        <RollingFile name="TraceLog" fileName="logs/trace.log"
                     filePattern="logs/trace-%d{yyyy-MM-dd-HH-mm}.log.gz">
            <PatternLayout pattern="%d [%t] %-5level %c - %msg%n"/>
            <Policies>
                <OnStartupTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="5MB"/>
                <TimeBasedTriggeringPolicy interval="1"/>
            </Policies>
            <DefaultRolloverStrategy max="3">
                <Delete basePath="logs">
                    <IfAccumulatedFileSize exceeds="2.2M"/>
                </Delete>
            </DefaultRolloverStrategy>

        </RollingFile>

        <RollingFile name="InfoErrorLog" fileName="logs/info_error.log"
                     filePattern="logs/info_error-%d{yyyy-MM-dd-HH-mm}.log.gz">
            <PatternLayout pattern="%d [%t] %-5level %c - %msg%n"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="5MB"/>
            </Policies>
        </RollingFile>


    </Appenders>

    <Loggers>
        <Logger name="lab.Frog" level="TRACE" additivity="false">
            <AppenderRef ref="TraceLog"/>
            <AppenderRef ref="Console"/>
        </Logger>

        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="InfoErrorLog"/>
        </Root>
    </Loggers>
</Configuration>
